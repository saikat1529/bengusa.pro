}

.client-testimonials__arrows { position: absolute; width: 30px; height: 100=
%; left: -2px; top: 0px; display: flex; flex-direction: column; justify-con=
tent: center; gap: 25px; padding-top: 20px; }

.client-testimonials__arrows .-next { transform: rotate(-90deg); }

.client-testimonials__arrows .-prev { transform: rotate(90deg); }

