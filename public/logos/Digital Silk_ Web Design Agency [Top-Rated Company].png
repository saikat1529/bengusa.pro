ase-in-out; }
  39% { opacity: 1; transform: rotate(645deg); animation-timing-function: l=
inear; }
  70% { opacity: 1; transform: rotate(770deg); animation-timing-function: e=
ase-out; }
  75% { opacity: 1; transform: rotate(900deg); animation-timing-function: e=
ase-out; }
  100%, 76% { opacity: 0; transform: rotate(900deg); }
}

