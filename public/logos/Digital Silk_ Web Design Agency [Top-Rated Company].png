t: 500; padding: 10px 0px; color: var(--w-color) !important; font-size: 16p=
x !important; }

.single-post__content-wrap .hdq_quiz_wrapper .hdq_jPaginate { padding: 10px=
 2rem 1em; text-align: left; }

.single-post__content-wrap .hdq_quiz_wrapper li::before { display: none !im=
portant; }

.single-post__content-wrap .hdq_quiz_wrapper .hdq_button { --btn-padding-to=
p-bottom: 8px; --btn-padding-left-right: 1.5em; text-transform: none; backg=
round: linear-gradient(225deg, rgb(0, 165, 228) 0%, rgb(129, 46, 227) 96.97=
%) !important; color: rgb(255, 255, 255) !important; border-radius: 3px !im=
portant; border: none !important; box-shadow: rgba(31, 5, 192, 0.25) 0px 5p=
x 20px !important; font-size: 20px !important; font-family: var(--btn-font-=
family) !important; font-weight: var(--btn-font-weight, 400) !important; pa=
dding: var(--btn-padding-top-bottom) var(--btn-padding-left-right) !importa=
nt; }

.single-post__content-wrap .hdq_results_wrapper { background: transparent; =
}

.single-post__content-wrap .hdq_results_wrapper .hdq_result { font-size: 2e=
m; color: var(--secondary-color2); }

.single-post__content-wrap .hdq_results_wrapper .hdq_results_title { margin=
: 0px !important; }

.dark-on .single-post__content-wrap .hdq_results_wrapper .hdq_results_title=
 { color: rgb(255, 255, 255) !important; }

.single-post__content-wrap .hdq_row_image { margin-bottom: 50px; }

.single-post__content-wrap .hdq_row_image > .hdq_label_answer { position: r=
elative; display: flex; flex-direction: column; justify-content: space-betw=
een; border: 1px solid rgb(210, 212, 223); border-radius: 10px; padding: 10=
px; }

.single-post__content-wrap .hdq_row_image > .hdq_label_answer img { flex: 1=
 1 auto; object-fit: contain; }

.single-post__content-wrap .hdq_row_image > .hdq_label_answer > div { posit=
ion: absolute; bottom: -12px; left: 0px; transform: translateY(100%); }

.single-post__content-wrap .hdq-options-check { margin-right: 20px; }

.single-post__content-wrap .hdq-options-check .hdq_toggle { height: 20px; w=
idth: 35px; }

.single-post__content-wrap .hdq-options-check .hdq_toggle::before { backgro=
und-color: rgb(214, 214, 224); box-shadow: none; }

.dark-on .single-post__content-wrap .hdq-options-check .hdq_toggle::before =
{ background-color: var(--w-bg-alt); }

.single-post__content-wrap .hdq-options-check .hdq_toggle::after { width: 1=
8px; height: 18px; top: 2px; left: 4px; box-shadow: none; background: rgb(2=
55, 255, 255); }

.single-post__content-wrap .hdq-options-check input[type=3D"checkbox"]:chec=
ked + .hdq_toggle::before { background-color: rgb(0, 185, 255); }

.single-post__content-wrap .hdq-options-check input[type=3D"checkbox"]:chec=
ked + .hdq_toggle::after { left: 25px; }

.single-post__content-wrap .hdq_question_answers_images { grid-template: au=
to / repeat(3, minmax(0px, 1fr)); gap: 15px; }

@media (max-width: 767px) {
  .single-post__content-wrap .hdq_question_answers_images { grid-template: =
auto / repeat(1, minmax(0px, 1fr)); }
}

.single-post__content-wrap .hdq_row_image > .hdq_label_answer { height: 100=
%; }

.single-post__content-wrap .hdq_row_image > .hdq_label_answer > div { displ=
ay: flex; align-items: flex-end; font-size: 16px; }

.single-post__content-wrap .hdq_row_image > .hdq_label_answer .hdq-options-=
check { top: -1px; margin-bottom: 0px !important; }

.single-post__content-wrap .hdq_results_inner { text-align: center; }

.single-post__content-wrap .hdq_share { background: transparent; }

.single-post__content-wrap .hdq_share img { margin: 0px; }

.single-post__content-wrap .gform_confirmation_message { text-align: center=
; color: rgb(0, 136, 38); font-size: 18px; margin-bottom: 3rem; }

.hdq_quiz .hdq_row:hover { background: transparent !important; }

.hdq_quiz_wrapper .hdq_label_answer p { margin: 0px; display: inline-block;=
 }

.hero .new_structure .c-block .c-image { position: relative; }

@media (min-width: 1280px) {
  .hero .c-block__media.projects .m-slider { padding-top: 100px; }
}

@media (min-width: 600px) and (max-width: 1200px) {
  .form-sticky { margin-bottom: 60px; }
  .services .sticky-image::after { max-height: 210px; bottom: 20%; }
}
