@keyframes spin {=20
  0% { --rotate: 0deg; }
  100% { --rotate: 360deg; }
}

@keyframes glowing {=20
  0% { background-position: 0px 0px; }
  50% { background-position: 400% 0px; }
  100% { background-position: 0px 0px; }
}

@keyframes btn-link-hover {=20
  0% { width: 0px; height: 0px; }
  50% { width: calc(100% + 5px); height: 4px; }
  100% { height: 100%; width: calc(100% + var(--btn-link-offset)); border-r=
adius: 4px; }
}

@keyframes btn-link-hover-out {=20
  0% { height: 100%; width: calc(100% + var(--btn-link-offset)); border-rad=
ius: 4px; }
  50% { width: calc(100% + 5px); height: 4px; }
  100% { width: 0px; height: 0px; }
}

@keyframes pulse-btn {=20
  0% { opacity: 0.2; }
  70% { opacity: 1; }
  100% { opacity: 0.2; }
}

